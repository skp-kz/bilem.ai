<!--
  Bilem Agent — MSI (WiX 5).
  • Установка на машину: «Program Files\Bilem Agent», ярлыки «Bilem Agent» на рабочем столе и в «Пуске» (для всех).
  • MajorUpgrade: новая версия заменяет старую; разрешены та же версия (бета → бета; AllowDowngrades включает и её) и откат на прежнюю («Откатить» в агенте).
  • .NET Framework 4.8 (решение Славы 18.10, F6): нет его — мастер предлагает поставить; агент ставится, затем запускается
    web-установщик Microsoft (ndp48-web.exe, внутри MSI). Тихая установка без .NET — отказ с понятной строкой в журнале установщика.
  • Данные C:\ProgramData\Bilem (базы, токен MCP, печати, SMTP, журнал) установщик не создаёт и не трогает — ни при обновлении,
    ни при удалении. Удалить и их: msiexec /x BilemAgent-….msi REMOVE_SETTINGS=1.
  • Публикации IIS, пулы и пользователя bilem в базах установщик не удаляет — перед удалением программы: bilem-agent remove (README).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Bilem Agent" Manufacturer="SKP.kz LLC" Version="$(var.MsiVersion)" UpgradeCode="0790128C-1323-4ACF-B2E5-DB25DE89CFDF"
           Scope="perMachine" Language="1049" Codepage="1251" InstallerVersion="500">
    <SummaryInformation Description="Bilem Agent $(var.SemVer)" Manufacturer="SKP.kz LLC" />
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize" />
    <!-- Откат на прежнюю версию: файлы старше установленных иначе не ставятся, а старая версия удаляется — остаётся пусто.
         «a» — ставить все файлы независимо от версий. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <MediaTemplate EmbedCab="yes" />

    <!-- .NET Framework 4.8: Release ≥ 528040 (свойство из WixToolset.Netfx). В мастере (UILevel 5) — предлагаем поставить;
         тихо (/qn, обновление кнопкой — там .NET уже есть) без него — отказ. -->
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
    <!-- Только для проверки установщика на машине, где .NET 4.8 есть (Windows Server 2022+ не даёт его удалить):
         msiexec /i … BILEM_TEST_NO_NETFX=1 — мастер и отказ ведут себя так, будто .NET нет -->
    <SetProperty Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" Action="BilemTestNoNetFx" Value="{}" Before="LaunchConditions" Sequence="both" Condition="BILEM_TEST_NO_NETFX = 1" />
    <Launch Condition="Installed OR WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED OR UILevel = 5"
            Message="Не установлен .NET Framework 4.8 — без него Bilem Agent не работает. Запустите установку двойным щелчком (мастер поставит .NET) или поставьте .NET 4.8: dotnet.microsoft.com/download/dotnet-framework/net48" />

    <Icon Id="BilemAgentIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="BilemAgentIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://bilem.ai" />
    <Property Id="ARPHELPLINK" Value="https://github.com/skp-kz/bilem.ai" />
    <Property Id="ARPCOMMENTS" Value="Bilem Agent $(var.SemVer)" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Bilem Agent">
        <Directory Id="REDISTFOLDER" Name="redist" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BinDir)\*.exe" />
      <!-- bilem-agent.com — командная строка -->
      <Files Include="$(var.BinDir)\*.com" />
      <Files Include="$(var.BinDir)\*.dll" />
      <Files Include="$(var.BinDir)\*.config" />
    </ComponentGroup>

    <!-- Web-установщик .NET Framework 4.8 от Microsoft (подписан Microsoft) — запускается после установки, если .NET нет -->
    <Component Id="NetFxWeb" Directory="REDISTFOLDER" Guid="3B9C1E6A-7D24-4F0B-9E51-2C8A6D4F1B37">
      <File Id="Ndp48Web" Source="$(var.Redist)\ndp48-web.exe" KeyPath="yes" />
    </Component>

    <!-- Ярлыки: те же имена, что создаёт сам агент (Shortcuts.cs) — при удалении программы исчезают -->
    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="6E8D33B1-0C8B-4C0B-9D7E-4D1B2B7F3A10">
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Bilem Agent" Target="[INSTALLFOLDER]bilem-agent.exe" WorkingDirectory="INSTALLFOLDER" Icon="BilemAgentIcon" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Bilem Agent" Target="[INSTALLFOLDER]bilem-agent.exe" WorkingDirectory="INSTALLFOLDER" Icon="BilemAgentIcon" />
      <RegistryValue Root="HKLM" Key="Software\Bilem\Agent" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <!-- Значок записи в «Программах и компонентах» — явно, из exe агента (у beta.2 на сервере записи не было видно) -->
      <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]" Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]bilem-agent.exe,0" />
    </Component>

    <!-- «Удалить и настройки»: только при удалении и только с REMOVE_SETTINGS=1 -->
    <SetProperty Id="BILEMDATA" Value="[CommonAppDataFolder]Bilem" After="AppSearch" Sequence="execute" />
    <Component Id="RemoveSettings" Directory="INSTALLFOLDER" Guid="A2F7C4D6-5E31-4C9A-8B2F-1D6E0B3C7A54">
      <util:RemoveFolderEx On="uninstall" Property="BILEMDATA" Condition="REMOVE_SETTINGS = 1" />
      <RegistryValue Root="HKLM" Key="Software\Bilem\Agent" Name="RemoveSettings" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Bilem Agent">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="NetFxWeb" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="RemoveSettings" />
    </Feature>

    <!-- «Готово» в конце мастера: запуск через оболочку Windows (WixShellExec — ShellExecute, с запросом прав и записью ошибки
         в журнал установщика). beta.2: прямой запуск процесса из мастера на сервере без .NET молча не срабатывал.
         Нет .NET — запускается web-установщик Microsoft; есть — Bilem Agent (если галочка). -->
    <CustomAction Id="ShellLaunch" BinaryRef="Wix4UtilCA_X86" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- Конец мастера: .NET есть — галочка «Запустить Bilem Agent»; нет — текст про установщик .NET -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить Bilem Agent" After="CostFinalize" Sequence="ui"
                 Condition="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED AND NOT REMOVE" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Требуется Microsoft .NET Framework 4.8. После нажатия «Готово» запустится веб-установщик Microsoft: следуйте его инструкциям, при запросе перезагрузите компьютер. Затем запустите Bilem Agent с ярлыка."
                 After="CostFinalize" Sequence="ui" Condition="NOT WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED AND NOT Installed" />

    <!-- Нет .NET — окно про него первым экраном, до копирования файлов (вместо «Добро пожаловать»); есть — обычное приветствие -->
    <InstallUISequence>
      <Show Dialog="NetFxDlg" Before="ProgressDlg" Condition="NOT Installed AND NOT WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
      <Show Dialog="BilemWelcomeDlg" Before="ProgressDlg" Condition="NOT Installed AND WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
    </InstallUISequence>

    <UI Id="BilemUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- Первая установка: (нет .NET — окно про .NET | есть — «Добро пожаловать») → «Готово к установке» → установка → конец -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="NetFxDlg" Condition="NOT Installed AND NOT WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="BilemWelcomeDlg" Condition="NOT Installed AND WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />

      <!-- Повторный запуск MSI: исправить / удалить -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="[WixShellExecTarget]" Value="[REDISTFOLDER]ndp48-web.exe" Order="1"
               Condition="NOT Installed AND NOT WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED AND NOT REMOVE" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="[WixShellExecTarget]" Value="[INSTALLFOLDER]bilem-agent.exe" Order="2"
               Condition="NOT Installed AND WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED AND WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="ShellLaunch" Order="3"
               Condition="NOT Installed AND NOT REMOVE AND (NOT WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED OR WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1)" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <!-- Приветствие (как стандартное WixUI) — когда .NET есть; своё, чтобы окно про .NET могло стоять первым вместо него -->
      <Dialog Id="BilemWelcomeDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.WelcomeDlgBitmap)" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.WelcomeDlgTitle)" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="!(loc.WelcomeDlgDescription)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Окно про .NET Framework 4.8 — первый экран: «Установить» (дальше — «Готово к установке») / «Отмена» (ничего не ставится) -->
      <Dialog Id="NetFxDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Не найден необходимый компонент" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Microsoft .NET Framework 4.8" />
        <Control Id="Body" Type="Text" X="25" Y="58" Width="320" Height="160" NoPrefix="yes"
                 Text="Для работы Bilem Agent требуется Microsoft .NET Framework 4.8. На этом компьютере он не установлен.&#13;&#10;&#13;&#10;Нажмите «Установить»: будет установлен Bilem Agent, а после нажатия «Готово» в конце мастера запустится веб-установщик Microsoft .NET Framework 4.8 (около 70 МБ загрузки с сайта Microsoft; может потребоваться перезагрузка).&#13;&#10;&#13;&#10;Нажмите «Отмена», чтобы выйти без изменений." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Установить">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
    <!-- Картинки мастера (вместо красных WiX): юрта мелкой мозаикой — утверждено Славой 18.10 -->
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)art/WixUIDialogBmp.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)art/WixUIBannerBmp.bmp" />
  </Package>
</Wix>
