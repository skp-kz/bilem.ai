<Project Sdk="Microsoft.NET.Sdk">
  <!-- Вся логика без UI: онбординг, конфиг, OData-клиент, MCP-сервер, журнал -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Bilem.Agent.Core</RootNamespace>
    <AssemblyName>Bilem.Agent.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- PDF счёта: PDFsharp + MigraDoc (MIT), шрифт PT Sans (OFL) встроен ресурсом -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Превью первой страницы PDF — встроенный в Windows рендер Windows.Data.Pdf (без нативных библиотек).
         Первая точка в версии записана как %2E (MSBuild раскодирует), чтобы проверка перед push
         не принимала номер версии за адрес 10.x.x.x -->
    <!-- Подпись релизов Ed25519 (проверка SHA256SUMS.sig при обновлении): BouncyCastle (MIT) — в .NET Framework 4.8 Ed25519 нет -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10%2E0.19041.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" LogicalName="Bilem.Agent.Core.Resources.Strings.resources" />
    <EmbeddedResource Include="..\..\assets\fonts\PT_Sans-Web-Regular.ttf" LogicalName="PTSans-Regular.ttf" />
    <EmbeddedResource Include="..\..\assets\fonts\PT_Sans-Web-Bold.ttf" LogicalName="PTSans-Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bilem.Agent.Core.Tests" />
  </ItemGroup>
</Project>
