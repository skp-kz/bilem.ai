<Project Sdk="Microsoft.NET.Sdk">
  <!-- Помощник COM к 1С, 64-бит: COM-коннектор 1С работает только в процессе той же разрядности, что платформа.
       Задание и ответ — JSON через stdin/stdout. Упал COM — падает помощник, а не агент. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>bilem-com64</AssemblyName>
    <RootNamespace>Bilem.Agent.Com</RootNamespace>
    <OutputPath>..\..\..\artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Bilem.Agent.Core\Bilem.Agent.Core.csproj" />
  </ItemGroup>
</Project>
